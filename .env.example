# ── Who is this for? ────────────────────────────────────────────────
FRIEND_NAME=Suyash          # shows in the app title, used in prompts
FRIEND_CITY=Prayagraj
FRIEND_EXAM=JEE             # e.g. "JEE" / "NEET" / "B.Sc 2nd year" / leave empty

REPO_URL=https://github.com/Yuser00123/samjhao   # footer 'Source' link

# ── Model: pick ONE block ───────────────────────────────────────────
# (1) Google AI Studio — Gemma 4, free, no card. Key: https://aistudio.google.com/apikey
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=paste-your-key-here

# (2) Ollama — fully offline on your laptop (ollama pull gemma3:4b)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b
# LLM_API_KEY=ollama

# (3) Groq — free tier, very fast (check current Gemma/Llama model ids on console.groq.com)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a gemma or llama model id from Groq>
# LLM_API_KEY=gsk_...

# (4) Native Gemini SDK instead of the OpenAI-compatible endpoint (pip install google-genai)
# LLM_PROVIDER=google
# LLM_MODEL=gemma-4-31b-it
# LLM_API_KEY=...

# (5) No model at all — UI demo with canned text
# LLM_PROVIDER=mock

# ── Tuning (optional) ───────────────────────────────────────────────
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=2000
# FOLD_SYSTEM=1             # if your provider rejects the "system" role
# DIARY_PATH=./diary.json   # persist the Doubt Diary to disk when running locally
